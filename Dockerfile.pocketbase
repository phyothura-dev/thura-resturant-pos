FROM alpine:3.20

ARG PB_VERSION=0.40.5
ARG TARGETARCH

RUN apk add --no-cache \
    unzip \
    ca-certificates \
    wget \
    curl

# Download official PocketBase release matching architecture
RUN ARCH="${TARGETARCH:-amd64}" && \
    wget https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_linux_${ARCH}.zip \
    && unzip pocketbase_${PB_VERSION}_linux_${ARCH}.zip -d /pb \
    && rm pocketbase_${PB_VERSION}_linux_${ARCH}.zip \
    && chmod +x /pb/pocketbase

WORKDIR /pb

COPY ./backend/pb_migrations /pb/pb_migrations

EXPOSE 8090

VOLUME ["/pb/pb_data"]

CMD ["/pb/pocketbase", "serve", "--http=0.0.0.0:8090", "--dir=/pb/pb_data"]
